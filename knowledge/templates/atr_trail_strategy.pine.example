//@version=6
strategy("HOOX ATR trail example", overlay=true, initial_capital=100000)

atrLen = input.int(14, "ATR length", minval=1)
atrMult = input.float(2.0, "ATR mult", minval=0.1, step=0.1)
fast = input.int(10, "Fast SMA", minval=1)
slow = input.int(30, "Slow SMA", minval=1)

f = ta.sma(close, fast)
s = ta.sma(close, slow)
a = ta.atr(atrLen)

longCond = ta.crossover(f, s)
shortCond = ta.crossunder(f, s)

if longCond
    strategy.entry("L", strategy.long)
if shortCond
    strategy.entry("S", strategy.short)

strategy.exit("XL", from_entry="L", stop=close - atrMult * a)
strategy.exit("XS", from_entry="S", stop=close + atrMult * a)

plot(f, "Fast", color=color.yellow)
plot(s, "Slow", color=color.blue)

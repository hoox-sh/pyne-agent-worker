//@version=6
indicator("HOOX RSI + SMA example", overlay=false)

len = input.int(14, "RSI length", minval=1)
smooth = input.int(9, "SMA of RSI", minval=1)

r = ta.rsi(close, len)
s = ta.sma(r, smooth)

plot(r, "RSI", color=color.teal)
plot(s, "SMA", color=color.orange)
hline(70, "Overbought", color=color.red)
hline(30, "Oversold", color=color.green)

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyne-agent-worker",
  // Set your Cloudflare® account_id or rely on wrangler login defaults.
  // "account_id": "YOUR_ACCOUNT_ID",
  "main": "src/index.ts",
  // AI Search namespace binding requires >= 2026-03-27
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },

  // Workers AI™ binding (chat + embeddings)
  "ai": {
    "binding": "AI"
  },

  // Optional managed hybrid RAG (AI Search). Falls back to Vectorize if unused.
  // Dashboard: create namespace + instance id "pyne-pine-kb", or create via API.
  // "remote": true so wrangler dev proxies to the deployed instance.
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],

  // Vectorize™ index for Pine Script™ knowledge RAG (BYO embeddings fallback)
  //   npx wrangler vectorize create pyne-agent-kb --dimensions=768 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "pyne-agent-kb"
    }
  ],

  // R2: raw knowledge documents (docs / corpus chunks / operator builtins).
  // Never commit those files to git — only live in R2.
  "r2_buckets": [
    {
      "binding": "KB",
      "bucket_name": "pyne-agent-kb",
      "preview_bucket_name": "pyne-agent-kb-dev"
    }
  ],

  // Optional D1 for legacy REST chat session history
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pyne-agent-sessions",
      "database_id": "5dd88bd5-c1da-4070-a77b-d424fea57225"
    }
  ],

  // Agents SDK Durable Objects (SQLite-backed)
  "durable_objects": {
    "bindings": [
      { "name": "PyneAgent", "class_name": "PyneAgent" },
      { "name": "PyneMcp", "class_name": "PyneMcp" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-agents-sdk",
      "new_sqlite_classes": ["PyneAgent", "PyneMcp"]
    }
  ],

  // Static assets (AXIS plugin + chat shells).
  // Worker-first for API / agents / MCP / plugin CORS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/plugin/*",
      "/plugins/*",
      "/health",
      "/v1/*",
      "/agents/*",
      "/mcp",
      "/mcp/*"
    ]
  },

  // Optional: sister pyne-worker for generate→validate→retry (NOT required).
  // "services": [
  //   { "binding": "PYNE_SERVICE", "service": "pyne-worker" }
  // ],

  "vars": {
    "SERVICE_NAME": "pyne-agent-worker",
    "SERVICE_VERSION": "0.2.0",
    "CHAT_MODEL": "@cf/qwen/qwen2.5-coder-32b-instruct",
    // Faster/smaller fallback when primary times out
    "CHAT_MODEL_FALLBACK": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EMBED_MODEL": "@cf/baai/bge-base-en-v1.5",
    "RAG_TOP_K": "8",
    "CORPUS_MAX_SCRIPTS": "1000",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,https://axis.hoox.sh,https://hoox.sh,https://hoox.sh/axis,https://pynescript.ai,https://pynescript-axis.pages.dev",
    "VALIDATE_DEFAULT": "true",
    "VALIDATE_MAX_RETRIES": "2"
    // Optional AI Gateway id (observability / caching attribution):
    // "AI_GATEWAY_ID": "pyne-agent-gateway"
  }

  // Secrets (set via `wrangler secret put`):
  //   API_KEY — shared secret for HTTP auth (X-API-Key / Authorization: Bearer)
  //   PYNE_WORKER_API_KEY — optional; only for HTTP pyne-worker validate loop
}

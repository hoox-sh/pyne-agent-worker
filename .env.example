# Local wrangler / scripts (never commit real secrets)
# Copy to .dev.vars for `wrangler dev`

# Shared secret for HTTP API (X-API-Key). Leave empty only for local open mode.
API_KEY=

# Comma-separated CORS origins (AXIS / HOOX local + prod)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://hoox.sh,https://hoox.sh/axis

# Optional: force chat model override (Workers AI model id)
# CHAT_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
# EMBED_MODEL=@cf/baai/bge-base-en-v1.5
